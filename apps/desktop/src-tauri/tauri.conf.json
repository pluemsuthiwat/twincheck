{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TwinCheck",
  "version": "../../../package.json",
  "identifier": "com.suthiwat.twincheck",
  "build": {
    "beforeDevCommand": "pnpm --filter @twincheck/web dev --port 5199 --strictPort",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "pnpm --filter @twincheck/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TwinCheck",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "copyright": "Copyright (c) 2026 Suthiwat Srisen",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Semantic config compare",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyMzE1MDdENTAwRkRGNjkKUldScDN3OVFmVkF4Z3RYRVA1dDJnUmFXNVBLdW1Xek9wZEZjMmhYTU00Vk8xaGJJU3czcm1sYVgK",
      "endpoints": ["https://github.com/pluemsuthiwat/twincheck/releases/latest/download/latest.json"]
    }
  }
}
